{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bundle install",
  "buildCommand": "bundle exec jekyll build",
  "build": {
    "env": {
      "LANG": "C.UTF-8",
      "LC_ALL": "C.UTF-8"
    }
  },
  "outputDirectory": "_site",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path((?!app-ads\\.txt$|googlea03ebb4f032001f5\\.html$).*)",
      "has": [{ "type": "host", "value": "saso-studio.vercel.app" }],
      "destination": "https://sasostudio.dev/:path",
      "permanent": true
    }
  ]
}
